diff --git a/tests/test_make_game_empty_translation.py b/tests/test_make_game_empty_translation.py
index 0d310226bb4cd0daabfbff35053252f1963cd37f..8ebd7cf0009a12a54c546b03e1ee1ca198fb88f5 100644
--- a/tests/test_make_game_empty_translation.py
