--- a/runtime/test/run_guest_draw.cmake
+++ b/runtime/test/run_guest_draw.cmake
@@ -24,16 +24,28 @@ endforeach()
 # The line test/d3d12_translated_draw_test.cpp prints under LEONIDA_M15_GUEST once every check has passed.
 set(marker "M1.5 guest: PASS, 4064 of 4096 pixels exact, 32 edge pixels the clear colour")
 
-file(TO_NATIVE_PATH "${GUEST}" guest)
-file(TO_NATIVE_PATH "${FIXTURE}" fixture)
-file(TO_NATIVE_PATH "${FIXTURE}/spirv" shaders)
 get_filename_component(guest_dir "${GUEST}" DIRECTORY)
-# Set here rather than as the test's ENVIRONMENT, before starting gta6rt on native Windows.
+if(RUNNER)
+  # The guest starts in its own directory. Resolve the fixture using the
+  # same Wine prefix and drive mappings as the loader, including wrapper arguments.
+  get_filename_component(guest "${GUEST}" NAME)
+  execute_process(COMMAND ${RUNNER} winepath.exe -w "${FIXTURE}"
+                  TIMEOUT ${TIMEOUT} RESULT_VARIABLE path_status OUTPUT_VARIABLE fixture
+                  OUTPUT_STRIP_TRAILING_WHITESPACE)
+  if(NOT "${path_status}" STREQUAL "0" OR fixture STREQUAL "")
+    message(FATAL_ERROR "winepath failed to resolve ${FIXTURE} (exit ${path_status})")
+  endif()
+  set(shaders "${fixture}\\spirv")
+else()
+  file(TO_NATIVE_PATH "${GUEST}" guest)
+  file(TO_NATIVE_PATH "${FIXTURE}" fixture)
+  file(TO_NATIVE_PATH "${FIXTURE}/spirv" shaders)
+endif()
 set(ENV{LEONIDA_D3D12} vulkan)
 set(ENV{LEONIDA_SHADERS} "${shaders}")
 
 execute_process(
-  COMMAND "${GTA6RT}" --run "${guest}" -- "${fixture}"
+  COMMAND ${RUNNER} "${GTA6RT}" --run "${guest}" -- "${fixture}"
   WORKING_DIRECTORY "${guest_dir}"
   TIMEOUT ${TIMEOUT}
   RESULT_VARIABLE result

