+OpReturn
+"""
+        with self.assertRaisesRegex(AssertionError, "unguarded block %merge"):
+            find_guarded_texel_block(spv)
+
+    def test_inactive_branch_access_is_rejected(self):
+        spv = """
+%entry = OpLabel
