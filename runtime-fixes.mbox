index 0000000000000000000000000000000000000000..66d4a680e3ff640ad3d5dbfdeed0ef4e225fdec4
--- /dev/null
+++ b/runtime/test/vk_khr_instance_addresses_test.cpp
@@ -0,0 +1,116 @@
+// Stage a TLAS pointer list through the real queue. Synthetic buffer addresses let this test
+// inspect the staged entries without submitting ray-tracing work or requiring a GPU.
+#include "vk_test_queue_stub.h"
+
+#include <array>
+#include <cstdio>
+
+namespace {
+using vk_queue_stub::handle;
+using vk_queue_stub::buffer;
+std::array<std::uint64_t, 2> staged{};
+unsigned builds = 0;
+constexpr VkDeviceAddress stage_base = 0x220000;
+constexpr VkDeviceAddress arena_base = 0x300000;
+constexpr VkDeviceAddress imported_base = 0x340000;
+
+VkResult VKAPI_CALL create_buffer(VkDevice, const VkBufferCreateInfo* info, const VkAllocationCallbacks*, VkBuffer* out) {
+    if (info->size > sizeof(staged)) return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    *out = handle<VkBuffer>(77);
+    return VK_SUCCESS;
+}
+void VKAPI_CALL destroy_buffer(VkDevice, VkBuffer, const VkAllocationCallbacks*) {}
+void VKAPI_CALL requirements(VkDevice, VkBuffer, VkMemoryRequirements* out) { *out = {sizeof(staged), 8, 1}; }
+VkResult VKAPI_CALL allocate_memory(VkDevice, const VkMemoryAllocateInfo*, const VkAllocationCallbacks*, VkDeviceMemory* out) {
+    *out = handle<VkDeviceMemory>(55);
+    return VK_SUCCESS;
+}
+void VKAPI_CALL free_memory(VkDevice, VkDeviceMemory, const VkAllocationCallbacks*) {}
+VkResult VKAPI_CALL bind_memory(VkDevice, VkBuffer, VkDeviceMemory, VkDeviceSize) { return VK_SUCCESS; }
+VkResult VKAPI_CALL map_memory(VkDevice, VkDeviceMemory, VkDeviceSize, VkDeviceSize, VkMemoryMapFlags, void** out) {
+    *out = staged.data();
+    return VK_SUCCESS;
+}
+void VKAPI_CALL unmap_memory(VkDevice, VkDeviceMemory) {}
+VkDeviceAddress VKAPI_CALL device_address(VkDevice, const VkBufferDeviceAddressInfo* info) {
+    if (info->buffer == handle<VkBuffer>(77)) return stage_base;
+    if (info->buffer == handle<VkBuffer>(123)) return imported_base;
+    if (info->buffer == handle<VkBuffer>(124)) return arena_base;
+    return 0;
+}
+void VKAPI_CALL build_instances(VkCommandBuffer, std::uint32_t count, const VkAccelerationStructureBuildGeometryInfoKHR* info,
+                                const VkAccelerationStructureBuildRangeInfoKHR* const*) {
+    if (count == 1 && info->geometryCount == 1 && info->pGeometries[0].geometry.instances.arrayOfPointers &&
+        info->pGeometries[0].geometry.instances.data.deviceAddress == stage_base) ++builds;
+}
+PFN_vkVoidFunction VKAPI_CALL ray_proc(VkDevice d, const char* name) {
+#define PROC(api, fn) if (std::strcmp(name, #api) == 0) return reinterpret_cast<PFN_vkVoidFunction>(fn)
+    PROC(vkCreateBuffer, create_buffer);
+    PROC(vkDestroyBuffer, destroy_buffer);
+    PROC(vkGetBufferMemoryRequirements, requirements);
+    PROC(vkAllocateMemory, allocate_memory);
+    PROC(vkFreeMemory, free_memory);
+    PROC(vkBindBufferMemory, bind_memory);
+    PROC(vkMapMemory, map_memory);
+    PROC(vkUnmapMemory, unmap_memory);
+    PROC(vkGetBufferDeviceAddress, device_address);
+    PROC(vkCmdBuildAccelerationStructuresKHR, build_instances);
+#undef PROC
+    return vk_queue_stub::queue_proc(d, name);
+}
+}  // namespace
+
+#define EXPECT(expr) do { if (!(expr)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #expr); return 1; } } while (0)
+
+int main() {
+    using namespace leonida;
+    VulkanContext ctx(ray_proc, handle<VkDevice>(1), false, false, true);
+    ctx.set_heap_base(arena_base);
+    VkPhysicalDeviceMemoryProperties memory{};
+    memory.memoryTypeCount = 1;
+    memory.memoryTypes[0].propertyFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    ctx.set_occlusion_resolve_memory(memory);
+    ctx.register_acceleration_structure(0x9000, handle<VkAccelerationStructureKHR>(1));
+
+    const std::array<std::uint64_t, 4> guest{0, 0, 0x110010, 0x8080};
+    auto list = buffer(111, 0x1000, sizeof(guest));
+    list.host = reinterpret_cast<const std::uint8_t*>(guest.data());
+    ctx.add_resource(1, list);
+    auto imported = buffer(123, 0x110000, 256);
+    ctx.add_resource(2, imported);
+    auto arena = buffer(124, 0x8000, 256);
+    arena.buffer_offset = arena.va;
+    ctx.add_resource(3, arena);
+
+    VulkanQueue queue(ctx, handle<VkQueue>(1), 0);
+    EXPECT(queue.ok());
+    CommandList commands;
+    BuildAccelerationStructure build{};
+    build.is_tlas = true;
+    build.dst_va = 0x9000;
+    build.scratch_va = 0xa000;
+    build.instance_pointers = true;
+    build.instance_count = 2;
+    build.instances_va = list.va + 16;
+    EXPECT(commands.build_acceleration_structure(build) && commands.close());
+    const CommandList* batch[] = {&commands};
+    const std::array<std::uint64_t, 2> expected{imported_base + 16, arena_base + 0x8080};
+    EXPECT(queue.execute(batch) == ReplayResult::success && builds == 1 && staged == expected);
+
+    // The closer alias ends after the first pointer. The containing CPU mapping supplies both entries.
+    auto alias = buffer(111, build.instances_va, 8);
+    alias.host = list.host + 16;
+    ctx.add_resource(4, alias);
+    EXPECT(queue.execute(batch) == ReplayResult::success && builds == 2 && staged == expected);
+    imported.buffer = handle<VkBuffer>(125);  // the driver returns no device address
+    ctx.add_resource(2, imported);
+    EXPECT(queue.execute(batch) == ReplayResult::invalid_copy && builds == 2);
+    imported.buffer = handle<VkBuffer>(123);
+    ctx.add_resource(2, imported);
+    ctx.remove_resource(1);
+    EXPECT(queue.execute(batch) == ReplayResult::invalid_copy && builds == 2);
+    list.host = nullptr;
+    ctx.add_resource(1, list);
+    EXPECT(queue.execute(batch) == ReplayResult::unsupported && builds == 2);
+    return 0;
+}
