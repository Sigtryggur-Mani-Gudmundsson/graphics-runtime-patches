#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
layout(local_size_x=2) in;
layout(buffer_reference, std430, buffer_reference_align=4) writeonly buffer Result { uint hit[2]; };
layout(push_constant) uniform Params { uvec2 tlas; Result result; } params;
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec3 origin = i == 0 ? vec3(0.25,0.25,1) : vec3(10,10,1);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(params.tlas), gl_RayFlagsOpaqueEXT, 255, origin, 0.001, vec3(0,0,-1), 10);
    while(rayQueryProceedEXT(q)) {}
    params.result.hit[i] = rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT ? 1u : 0u;
}
