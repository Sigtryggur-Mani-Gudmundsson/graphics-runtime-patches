diff --git a/runtime/test/shaders/vs_m15.asm b/runtime/test/shaders/vs_m15.asm
--- a/runtime/test/shaders/vs_m15.asm
+++ b/runtime/test/shaders/vs_m15.asm
@@ -2,24 +2,26 @@
 ; translated game VS that fetch without the driver's fetch program do. Run: d3d12_translated_draw_test (the VS through
 ; a D3D12 graphics PSO found by the SHA-256 of its FSSM program).
 ;
-; User data, from the root signature [0] descriptor table, [1] four 32-bit constants (docs/d3d12_vulkan.md 3.5):
-;   s[0:1] = console VA of the table's first slot: the 16 bytes of a V# (base VA, stride 32, 9 records)
-;   s2, s3 = the draw's clip-space offset (x, y) as floats;   s4, s5 = used by the pixel shader (s4: bias)
+; User data, from the root signature [0..16] descriptor tables, [17] four 32-bit constants (docs/d3d12_vulkan.md 3.5):
+;   s8 = 32-bit console VA of the table's first slot: the 16 bytes of a V# (base VA, stride 32, 9 records)
+;   s25, s26 = the draw's clip-space offset (x, y) as floats;   s27, s28 = used by the pixel shader (s27: bias)
 ; v0 = VertexIndex. The draw has BaseVertex 0 and BaseInstance 0, so v0 is the same with and without the translator's
 ; zero-based ids (PR 436): both give 0, 1, 2, ... for DrawInstanced(n, 1, 0, 0). A non-zero StartVertexLocation would
 ; make the two differ (hardware: zero-based, base in an SGPR), so the test never uses one.
 ; Vertex record, 32 bytes: position xyzw at 0, colour rgba at 16 (both float).
-;   pos0   = (position.x + s2, position.y + s3, position.z, position.w)
+;   pos0   = (position.x + s25, position.y + s26, position.z, position.w)
 ;   param0 = colour
 ; fssm-at: 0x10
 ; fssm-data: 0x35314d56 0x20535620
+s_mov_b32 s0, s8
+s_mov_b32 s1, 0
 s_load_dwordx4 s[8:11], s[0:1], 0x0
 s_waitcnt lgkmcnt(0)
 buffer_load_dwordx4 v[4:7], v0, s[8:11], 0 idxen
 buffer_load_dwordx4 v[8:11], v0, s[8:11], 0 idxen offset:16
 s_waitcnt vmcnt(0)
-v_add_f32_e32 v4, s2, v4
-v_add_f32_e32 v5, s3, v5
+v_add_f32_e32 v4, s25, v4
+v_add_f32_e32 v5, s26, v5
 exp pos0 v4, v5, v6, v7 done
 exp param0 v8, v9, v10, v11
 s_endpgm
diff --git a/runtime/test/shaders/ps_m15.asm b/runtime/test/shaders/ps_m15.asm
--- a/runtime/test/shaders/ps_m15.asm
+++ b/runtime/test/shaders/ps_m15.asm
@@ -5,7 +5,7 @@
 ; code base, dwords 34-35, is the console VA of the FSSM program the layer uploaded). The table of four floats is at
 ; blob offset 0x100: 0x100 - 4 = 0xfc. build.py writes that blob (fssm-at / fssm-data below) next to the SPIR-V, and
 ; adds its SHA-256 to the index, as the translator's --fssm-dir does for the game's programs.
-;   scale = (0.5, 2.0, 1.0, 1.0)      s4 = bias, a float from the root constants (s2, s3 are the VS offset)
+;   scale = (0.5, 2.0, 1.0, 1.0)      s27 = bias, a float from the root constants (s25, s26 are the VS offset)
 ;   mrt0  = (r * 0.5 + bias, g * 2.0 + bias, b * 1.0 + bias, a * 1.0)
 ; The test draws colour (0.25, 0.5, 0.75, 1) with bias 0 and 0.125, and colour (1, 0, 0.5, 1) with bias 0.25. Every
 ; value is a short binary fraction, so the float render target holds the exact result, bit for bit:
@@ -28,9 +28,9 @@
 v_interp_p1_f32_e32 v5, v0, attr0.w
 v_interp_p2_f32_e32 v5, v1, attr0.w
 s_waitcnt lgkmcnt(0)
-v_fma_f32 v2, v2, s8, s4
-v_fma_f32 v3, v3, s9, s4
-v_fma_f32 v4, v4, s10, s4
+v_fma_f32 v2, v2, s8, s27
+v_fma_f32 v3, v3, s9, s27
+v_fma_f32 v4, v4, s10, s27
 v_mul_f32_e32 v5, s11, v5
 exp mrt0 v2, v3, v4, v5 done vm
 s_endpgm
