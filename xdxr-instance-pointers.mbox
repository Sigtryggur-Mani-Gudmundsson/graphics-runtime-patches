diff --git a/runtime/test/vk_xdxr_build_test.cpp b/runtime/test/vk_xdxr_build_test.cpp
index a0b3f8b6a6f73bd0c12ff941d847e2c1be5b3f3a..f0352405b24f42654a15bcc08aa8949b8d2f4dc2 100644
--- a/runtime/test/vk_xdxr_build_test.cpp
+++ b/runtime/test/vk_xdxr_build_test.cpp
@@ -18,7 +18,7 @@
 // (refits) of the same structure, and writes nothing.
 #include "vk_test_device.h"
 #include "xdxr_build_output.h"
-#include "../src/xdxr_build.h"
+#include "../src/vulkan_backend.h"
 
 #include <algorithm>
 #include <chrono>
@@ -609,6 +609,103 @@ int main(int argc, char** argv) {
         std::printf("copies: blas_clone, blas_compacted (%llu bytes), tlas_refit_clone\n",
                     static_cast<unsigned long long>(compacted));
     }
+    // GPU-written pointer list. Physically reverse the descriptors so indexing the descriptor backing
+    // buffer directly cannot pass. The pointer list has extra zeroed room for the previous packed reader.
+    {
+        VulkanContext context(gpu.device_proc, gpu.device, true, false, false, true);
+        EXPECT(context.xdxr_acceleration_structures());
+        context.set_heap_base(bias);
+        VkPhysicalDeviceMemoryProperties memory{};
+        gpu.instance_fn<PFN_vkGetPhysicalDeviceMemoryProperties>("vkGetPhysicalDeviceMemoryProperties")(gpu.physical, &memory);
+        context.set_occlusion_resolve_memory(memory);
+        VulkanQueue queue(context, gpu.queue, gpu.family);
+        EXPECT(queue.ok());
+
+        Buffer descriptors = make(gpu, 64 * count);
+        void* list_map = nullptr;
+        const auto list_buffer = gpu.buffer(64 * count, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                                            &list_map);
+        EXPECT(descriptors.buffer && list_buffer);
+        std::memset(list_map, 0, 64 * count);
+        ResourceBinding list_binding{};
+        list_binding.buffer = list_buffer;
+        list_binding.va = va(gpu.device_address(list_buffer));
+        list_binding.size = 8 * count;
+        context.add_resource(1, list_binding);
+
+        std::uint64_t pointers[count]{};
+        for (std::uint32_t i = 0; i < count; ++i) {
+            const auto offset = 64 * (count - 1 - i);
+            std::memcpy(static_cast<char*>(descriptors.map) + offset, static_cast<const char*>(descs.map) + 64 * i, 64);
+            pointers[i] = va(descriptors.address) + offset;
+        }
+        auto upload_pointers = [&] {
+            return gpu.run([&](VkCommandBuffer cb) {
+                gpu.fn<PFN_vkCmdUpdateBuffer>("vkCmdUpdateBuffer")(cb, list_buffer, 0, sizeof pointers, pointers);
+                VkMemoryBarrier ready{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+                ready.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+                ready.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+                gpu.fn<PFN_vkCmdPipelineBarrier>("vkCmdPipelineBarrier")(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                    VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &ready, 0, nullptr, 0, nullptr);
+                return true;
+            });
+        };
+        EXPECT(upload_pointers());
+        Buffer work = make(gpu, layout.scratch + 255);
+        EXPECT(work.buffer);
+        BuildAccelerationStructure build{};
+        build.dst_va = va(base);
+        build.scratch_va = va((work.address + 255) & ~std::uint64_t(255));
+        build.instances_va = list_binding.va;
+        build.instance_count = count;
+        build.is_tlas = true;
+        build.instance_pointers = true;
+        build.build_flags = VK_BUILD_ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT_KHR;
+        auto run_list = [&] {
+            CommandList list;
+            if (!list.build_acceleration_structure(build) || !list.close()) return false;
+            const CommandList* batch[]{&list};
+            return queue.execute(batch) == ReplayResult::success && queue.idle() &&
+                   gpu.run([&](VkCommandBuffer cb) { barrier_to_host(gpu, cb); return true; });
+        };
+        EXPECT(run_list());
+        EXPECT(write_file(dir + "/tlas_pointers_arena.bin", tlas_bytes, header_size(tlas_bytes)));
+        EXPECT(write_file(dir + "/tlas_pointers_arena.json", json2.data(), json2.size()));
+        ResourceBinding placed{};
+        placed.buffer = descriptors.buffer;
+        placed.va = 0x700000000000ull;
+        placed.size = 64 * count;
+        placed.imported_address = descriptors.address;
+        context.add_resource(2, placed);
+        // This alias contains the pointer at +128 but ends before its 64-byte descriptor does.
+        auto short_alias = placed;
+        short_alias.va += 112;
+        short_alias.size = 64;
+        short_alias.imported_address = descriptors.address;
+        context.add_resource(3, short_alias);
+
+        for (std::uint32_t i = 1; i < count; i += 2)
+            pointers[i] = placed.va + 64 * (count - 1 - i);
+        EXPECT(upload_pointers());
+        EXPECT(run_list());
+        EXPECT(write_file(dir + "/tlas_pointers.bin", tlas_bytes, header_size(tlas_bytes)));
+        EXPECT(write_file(dir + "/tlas_pointers.json", json2.data(), json2.size()));
+        // Replace the list on the GPU and rotate the physical descriptors while preserving their logical order.
+        for (std::uint32_t i = 0; i < count; ++i) {
+            const auto offset = 64 * ((i + 1) % count);
+            auto* dst_desc = static_cast<char*>(descriptors.map) + offset;
+            std::memcpy(dst_desc, static_cast<const char*>(descs.map) + 64 * i, 64);
+            std::memcpy(dst_desc, insts[i].m, 48);
+            pointers[i] = (i % 2 ? va(descriptors.address) : placed.va) + offset;
+        }
+        EXPECT(upload_pointers());
+        build.update = true;
+        build.src_va = build.dst_va;
+        EXPECT(run_list());
+        EXPECT(write_file(dir + "/tlas_pointers_refit.bin", tlas_bytes, header_size(tlas_bytes)));
+        EXPECT(write_file(dir + "/tlas_pointers_refit.json", json.data(), json.size()));
+    }
+
     std::printf("tlas: %u instances, %u bytes\nvk_xdxr_build_test: built every case\n", count, layout.size);
     return 0;
 }
