+    // A KHR TLAS built with D3D12_ELEMENTS_LAYOUT_ARRAY_OF_POINTERS holds console VAs in its pointer list; Vulkan
+    // reads those 8-byte entries as device addresses. Stage a translated copy in our own host-visible buffer instead
+    // of editing the guest's input. The caller keeps the stage until the submission that builds with it completes.
+    ReplayResult stage_khr_instances(const ReplayFunctions& vk, const BuildAccelerationStructure& build,
+                                     std::vector<RayBuildStage>& stages, VkDeviceAddress& address) {
+        if (!vk.host_at || !vk.buffer_at || !build.instance_count) return ReplayResult::unsupported;
+        const std::uint64_t bytes = 8ull * build.instance_count;
+        const std::uint8_t* guest = nullptr;
+        const HostReadStatus status = vk.host_at(build.instances_va, bytes, guest);
+        if (status == HostReadStatus::not_cpu_written) return ReplayResult::unsupported;
+        if (status != HostReadStatus::ok) return ReplayResult::invalid_copy;
+
+        return stage_ray_data(bytes, stages, address, [&](void* mapped) {
+            // A title-placed buffer's console VA can be unrelated to its Vulkan device address.
+            // Look up the backing buffer, reusing its base across adjacent entries in the same buffer.
+            VkBuffer previous_buffer = VK_NULL_HANDLE;
+            VkDeviceAddress buffer_base = 0;
+            for (std::uint32_t i = 0; i < build.instance_count; ++i) {
+                std::uint64_t va = 0;
+                std::memcpy(&va, guest + 8ull * i, sizeof(va));
+                VkBuffer buffer = VK_NULL_HANDLE;
+                VkDeviceSize offset = 0;
+                std::uint64_t room = 64;  // one D3D12_RAYTRACING_INSTANCE_DESC
+                if (!va || !vk.buffer_at(va, room, buffer, offset) || room < 64) {
+                    return ReplayResult::invalid_copy;
+                }
+                if (buffer != previous_buffer) {
+                    VkBufferDeviceAddressInfo info{VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO};
+                    info.buffer = buffer;
+                    buffer_base = context_.vk.vkGetBufferDeviceAddress(context_.device(), &info);
+                    previous_buffer = buffer;
+                }
+                if (!buffer_base || offset > UINT64_MAX - buffer_base) {
+                    return ReplayResult::invalid_copy;
+                }
+                const std::uint64_t device_address = buffer_base + offset;
+                std::memcpy(static_cast<std::uint8_t*>(mapped) + 8ull * i, &device_address, sizeof(device_address));
+            }
+            return ReplayResult::success;
+        });
+    }
+
+    // Entries use the same (start VA, resource ID) ordering as the CPU lookup. A descriptor occupies
+    // 64 bytes. Each entry names its last valid descriptor start, and the furthest such start among
+    // earlier entries. This lets the shader stop its backward search as soon as no alias can cover it.
+    ReplayResult stage_xdxr_imports(std::vector<RayBuildStage>& stages, XdxrInstanceTable& table) {
+        struct Entry { std::uint64_t start, last, bias, prefix_last; };
+        static_assert(sizeof(Entry) == 32);
+        std::vector<Entry> entries;
+        context_.buffer_vas_.for_each_range([&](std::uint64_t start, std::uint64_t size, ResourceId id) {
+            if (size < 64) return;
+            const auto* binding = context_.resolve(id);
+            if (!binding || !binding->imported_address) return;
+            const auto last = start + std::min(UINT64_MAX - start, size - 64);
+            const auto prefix = entries.empty() ? last : std::max(last, entries.back().prefix_last);
+            entries.push_back({start, last, binding->imported_address - start, prefix});
+        });
+        table = {};
+        if (entries.empty()) return ReplayResult::success;
+        // The shader indexes its table with 32-bit byte offsets.
+        if (entries.size() > UINT32_MAX / sizeof(Entry)) return ReplayResult::unsupported;
+        table.count = static_cast<std::uint32_t>(entries.size());
+        const auto bytes = entries.size() * sizeof(Entry);
+        return stage_ray_data(bytes, stages, table.address, [&](void* mapped) {
+            std::memcpy(mapped, entries.data(), bytes);
+            return ReplayResult::success;
+        });
+    }
