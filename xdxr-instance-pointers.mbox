+++ b/runtime/src/xdxr_build.comp
@@ -273,12 +273,47 @@ void build_triangle(uint t) {
 }
 
 // ---- MODE_INSTANCES ----
+bool addr_less(uvec2 a, uvec2 b) {
+    return a.y < b.y || (a.y == b.y && a.x < b.x);
+}
+uvec2 load_address(uvec2 base, uint offset) {
+    return uvec2(load(base, offset), load(base, offset + 4u));
+}
+
+// An import entry is four 64-bit words: first VA, last VA that fits a descriptor, device-address
+// bias and prefix maximum last VA. Ties are in resource-ID order, like BufferVaIndex::find.
+uvec2 instance_address(uint i) {
+    if (pc.arg0 == 0u) return add(pc.src0, 64u * i);
+    uvec2 va = load_address(pc.src0, 8u * i);
+    if (is_null(va)) return va;
+    uint lo = 0u, hi = pc.arg1;
+    while (lo < hi) {
+        uint mid = lo + (hi - lo) / 2u;
+        if (addr_less(va, load_address(pc.src1, 32u * mid))) hi = mid;
+        else lo = mid + 1u;
+    }
+    while (lo != 0u) {
+        uint entry = 32u * --lo;
+        if (addr_less(load_address(pc.src1, entry + 24u), va)) break;
+        if (!addr_less(load_address(pc.src1, entry + 8u), va))
+            return add64(va, load_address(pc.src1, entry + 16u));
+    }
+    return add64(va, pc.bias);
+}
+
 void build_instance(uint i) {
-    uint d = 64u * i;
+    uvec2 desc = instance_address(i);
     float m[12];
-    for (uint k = 0u; k < 12u; ++k) m[k] = uintBitsToFloat(load(pc.src0, d + 4u * k));
-    uint id_mask = load(pc.src0, d + 48u), contrib = load(pc.src0, d + 52u);
-    uvec2 blas_va = uvec2(load(pc.src0, d + 56u), load(pc.src0, d + 60u));
+    uint id_mask = 0u, contrib = 0u;
+    uvec2 blas_va = uvec2(0u);
+    if (!is_null(desc)) {
+        for (uint k = 0u; k < 12u; ++k) m[k] = uintBitsToFloat(load(desc, 4u * k));
+        id_mask = load(desc, 48u);
+        contrib = load(desc, 52u);
+        blas_va = load_address(desc, 56u);
+    } else {
+        for (uint k = 0u; k < 12u; ++k) m[k] = 0.0;
+    }
     uint o = pc.elements_off + 128u * i;
     for (uint k = 0u; k < 12u; ++k) storef(pc.dst, o + 4u * k, m[k]);
     store(pc.dst, o + 48u, id_mask);
