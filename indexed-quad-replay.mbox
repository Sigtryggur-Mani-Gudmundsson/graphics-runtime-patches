+// Expand each group of four GPU-resident indices into (0,1,2) (0,2,3). A single instanced
+// triangle-list draw then preserves the provoking vertex, vertex indices and instance order.
+inline void expand_quad_indices(const ReplayFunctions& vk, VkCommandBuffer cb, const PreparedDraw& d,
+                                std::uint32_t first) {
+    const VkDeviceSize unit = d.index_type == VK_INDEX_TYPE_UINT32 ? 4 : 2;
+    const auto& out = d.quad;
+    constexpr auto transfer_rw = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    memory_barrier(vk, cb, VK_ACCESS_MEMORY_WRITE_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                   transfer_rw, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    if (out.available < out.count / 6 * 4) {
+        // A missing or partial input reads zero. Six 16-bit indices are already fill-aligned.
+        vk.fill_buffer(cb, out.buffer, out.offset, out.count * unit, 0);
+        if (out.available)
+            memory_barrier(vk, cb, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    }
+    // Bound host memory per command independently of the size of the draw.
+    constexpr std::uint32_t batch = 64;
+    std::array<VkBufferCopy, batch * 3> regions;
+    const VkDeviceSize source = d.index_offset + first * unit;
+    for (std::uint32_t begin = 0; begin < out.available; begin += batch * 4) {
+        std::uint32_t n = 0;
+        const auto end = std::min(begin + batch * 4, out.available);
+        for (auto index = begin; index < end; index += 4) {
+            const auto copy = [&](std::uint32_t from, std::uint32_t to, std::uint32_t count) {
+                if (index + from >= end) return;
+                regions[n++] = {source + (index + from) * unit,
+                                out.offset + (VkDeviceSize(index / 4) * 6 + to) * unit,
+                                std::min(count, end - (index + from)) * unit};
+            };
+            copy(0, 0, 3);
+            copy(0, 3, 1);
+            copy(2, 4, 2);
+        }
+        vk.copy_buffer(cb, d.index_buffer, out.buffer, n, regions.data());
+    }
+    memory_barrier(vk, cb, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                   VK_ACCESS_INDEX_READ_BIT, VK_PIPELINE_STAGE_VERTEX_INPUT_BIT);
+}
