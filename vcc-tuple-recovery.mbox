+    def test_llvm19_export_overlaps_the_following_literal_move(self):
+        # LLVM 19 reports the first SMEM word as invalid, reads the second as a normalized export,
+        # and consumes the first word of the literal address move as its operands.
+        move = ("v_mov_b32_e32 v6, 0x3000", "ff 02 0c 7e 00 30 00 00")
+        read = ("v_mov_b32_e32 v10, s100", "64 02 14 7e")
+        store = ("global_store_dword v6, v10, s[0:1]", "00 80 70 dc 06 0a 00 00")
+        program = SET_SGPR_V + [(None, LOAD_X8_VCC), move, WAIT, read, store, STORE_X4[-1]]
+        data, blob = listing_and_blob(program)
+        lines = data.decode().splitlines()
+        exp = "\texp mrt0 off, off, off, off " + encoding("00 00 00 f8 ff 02 0c 7e")
+        at = lines.index(INVALID)
+        lines[at:at + 3] = [INVALID, exp, INVALID]
+        spv = translate_listing(NAME, ("\n".join(lines) + "\n").encode(), fssm=blob)
+        self.assertEqual(run(spv, {BASE: 0x1A2B3C4D}).get(OUT), 0x1A2B3C4D)
+
+    def test_image_address_words_must_be_inside_the_code_range(self):
+        # An NSA image instruction has up to three trailing dwords holding address VGPRs.
+        # A pipeline blob may have more bytes after the program's declared end.
+        for opcode, count in ((0x0a, 1), (0x0c, 2), (0x0e, 3)):
+            with self.subTest(address_words=count):
+                image = f"{opcode:02x} 1f 00 f0 01 04 19 00"
+                prefix = SET_SGPR_V + [(None, LOAD_X8_VCC), WAIT]
+                tail = bytes.fromhex("02 00 00 00") * count
+                data, blob = listing_and_blob(prefix + [(None, image)])
+                with self.assertRaisesRegex(rdna2spirv.Unsupported, "fall-through into undecodable words"):
+                    translate_listing(NAME, data, fssm=blob + tail)
+                complete = prefix + [(None, image + " " + tail.hex()), WAIT_V] + STORE_X4
+                self.assertIn("OpFunctionCall %uint %desc_lookup_fn", translate(complete))
+
     def test_other_undecodable_words_are_still_refused(self):
         # SHADER-813: a rejected word that is not a tuple into vcc (sdata 112, not a register) stays undecodable,
