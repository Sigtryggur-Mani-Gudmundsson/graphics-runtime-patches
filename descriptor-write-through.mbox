+                EXPECT(vsharp_base(from.ptr) == 0);
+                EXPECT(VirtualProtect(reinterpret_cast<void*>(cpu), hd.NumDescriptors * step, previous, &previous));
+                c.device->CreateConstantBufferView(&cbv, from);
