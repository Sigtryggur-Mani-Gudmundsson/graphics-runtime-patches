 runtime/shims/d3d12_vulkan_device.cpp |  9 +++++
 runtime/shims/d3d12_xs_device.cpp     | 49 +++++++++++++++++++--------
 runtime/shims/d3d12_xs_device.h       |  4 +++
 runtime/test/d3d12_title_va_test.cpp  | 45 +++++++++++++++++++-----
 5 files changed, 87 insertions(+), 24 deletions(-)

