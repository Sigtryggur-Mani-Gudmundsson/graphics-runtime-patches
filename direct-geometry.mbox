From c36371327449cb05994d62764989ca84428dd293 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Tue, 24 Nov 2026 02:19:32 +0000
Subject: [PATCH] fix: resolve imported geometry addresses in XDXR and Vulkan
 builds


diff --git a/runtime/shims/d3d12_vulkan_device.cpp b/runtime/shims/d3d12_vulkan_device.cpp
index 81165c1d29dbf8858c8d8ac66609515269470332..431858635b4d9498fe45877e4cc814484495e753 100644
--- a/runtime/shims/d3d12_vulkan_device.cpp
+++ b/runtime/shims/d3d12_vulkan_device.cpp
@@ -2080,6 +2080,7 @@ public:
         binding.size = desc_.Width;
         binding.host = static_cast<const std::uint8_t*>(address);
         binding.host_readable = true;
+        binding.imported_address = buffer_va_;
         binding.va = va_;
         device_.context->add_resource(id(), binding);
         return S_OK;
diff --git a/runtime/src/vulkan_backend.h b/runtime/src/vulkan_backend.h
index b85e0e1e7be1c5f5babd1e8211f7bb27eaf4392b..0ef89fd6fb4f7d822f9c7ca4cdeb38527a7215f2 100644
--- a/runtime/src/vulkan_backend.h
+++ b/runtime/src/vulkan_backend.h
@@ -1009,6 +1009,16 @@ public:
             host = b->host + offset;
             return HostReadStatus::ok;
         };
+        // Host imports keep the title's host pointer as their console VA. All other ray-build addresses
+        // retain their arena-relative representation, including wrapped VAs below the arena base.
+        if (xdxr || ray_tracing) {
+            replay_.imported_address = [this](std::uint64_t va, std::uint64_t bytes) -> VkDeviceAddress {
+                BufferVaIndex<ResourceId>::Hit hit{};
+                if (!buffer_vas_.find(va, hit, bytes)) return 0;
+                const auto* b = resolve(hit.id);
+                return b && b->imported_address ? b->imported_address + (va - b->va) : 0;
+            };
+        }
         if (xdxr && loaded_) {
             xdxr_ = std::make_unique<XdxrBuilder>(get, device);
             if (xdxr_->loaded()) {
@@ -1021,31 +1031,30 @@ public:
                            (!b.update || (b.build_flags & VK_BUILD_ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT_KHR) != 0);
                 };
                 replay_.xdxr_record = [this](VkCommandBuffer cb, const BuildAccelerationStructure& b) {
-                    // Every address is a console VA in the GPU address arena: the device address is heap_base + VA,
-                    // and the BLAS addresses in instance descs get the same bias.
+                    // BLAS references embedded in instance descriptors use the console address-window bias.
                     const std::uint64_t base = replay_.heap_base;
                     XdxrLayout layout;
                     layout.compute(xdxr_elements(b), b.is_tlas, xdxr_box16(b));
                     // PERFORM_UPDATE refits the source (the destination itself when no source is given, as D3D12
                     // allows for an in-place update); a full build otherwise.
-                    const std::uint64_t from = b.update ? base + (b.src_va ? b.src_va : b.dst_va) : 0;
+                    const std::uint64_t from = b.update ? replay_.ray_address(b.src_va ? b.src_va : b.dst_va, layout.size) : 0;
                     if (b.is_tlas) {
-                        xdxr_->record_tlas(cb, layout, b.instances_va ? base + b.instances_va : 0, base + b.dst_va,
-                                           base + b.scratch_va, base, from);
+                        xdxr_->record_tlas(cb, layout, replay_.ray_address(b.instances_va, 64ull * b.instance_count),
+                                           replay_.ray_address(b.dst_va, layout.size), replay_.ray_address(b.scratch_va, layout.scratch),
+                                           base, from);
                     } else {
                         std::vector<XdxrTriangles> geometries;
-                        xdxr_inputs(b, &geometries, base);
-                        xdxr_->record_blas(cb, layout, geometries, base + b.dst_va, base + b.scratch_va, from,
+                        xdxr_inputs(b, &geometries, base, &replay_);
+                        xdxr_->record_blas(cb, layout, geometries, replay_.ray_address(b.dst_va, layout.size),
+                                           replay_.ray_address(b.scratch_va, layout.scratch), from,
                                            xdxr_pair(b));
                     }
                 };
                 replay_.xdxr_copy = [this](VkCommandBuffer cb, std::uint64_t src, std::uint64_t dst, std::uint64_t bytes) {
-                    const std::uint64_t base = replay_.heap_base;
-                    xdxr_->record_copy(cb, base + src, base + dst, bytes);
+                    xdxr_->record_copy(cb, replay_.ray_address(src), replay_.ray_address(dst, bytes), bytes);
                 };
                 replay_.xdxr_postbuild = [this](VkCommandBuffer cb, std::uint64_t src, std::uint64_t dest) {
-                    const std::uint64_t base = replay_.heap_base;
-                    xdxr_->record_postbuild(cb, base + src, base + dest);
+                    xdxr_->record_postbuild(cb, replay_.ray_address(src), replay_.ray_address(dest, 8));
                 };
             } else {
                 xdxr_.reset();
@@ -1337,7 +1346,11 @@ public:
     }
     // The geometries as the builder reads them, with `base` added to their VAs; false for an input it cannot read
     // (a vertex format other than R32G32B32_FLOAT or R32G32_FLOAT, an index type other than none/R16/R32).
-    static bool xdxr_inputs(const BuildAccelerationStructure& b, std::vector<XdxrTriangles>* out, std::uint64_t base) {
+    static bool xdxr_inputs(const BuildAccelerationStructure& b, std::vector<XdxrTriangles>* out, std::uint64_t base,
+                            const ReplayFunctions* replay = nullptr) {
+        const auto addr = [&](std::uint64_t va, std::uint64_t bytes) {
+            return replay ? replay->ray_address(va, bytes) : (va ? base + va : 0);
+        };
         if (b.is_tlas) return true;
         for (const auto& t : b.triangles) {
             if (t.vertex_format != VK_FORMAT_R32G32B32_SFLOAT && t.vertex_format != VK_FORMAT_R32G32_SFLOAT) return false;
@@ -1347,13 +1360,13 @@ public:
             if (count && t.index_type && !t.index_va) return false;
             if (!out) continue;
             XdxrTriangles g;
-            g.vertices = t.vertex_va ? base + t.vertex_va : 0;
+            g.vertices = addr(t.vertex_va, ray_vertex_bytes(t));
             g.vertex_stride = t.vertex_stride;
             g.xy_only = t.vertex_format == VK_FORMAT_R32G32_SFLOAT;
-            g.indices = t.index_type && t.index_va ? base + t.index_va : 0;
+            g.indices = t.index_type ? addr(t.index_va, (t.index_type == 1 ? 2ull : 4ull) * t.index_count) : 0;
             g.index_type = t.index_type;
             g.triangle_count = count;
-            g.transform = t.transform_va ? base + t.transform_va : 0;
+            g.transform = addr(t.transform_va, 48);
             g.flags = t.flags | (t.opaque ? 1u : 0u);
             out->push_back(g);
         }
diff --git a/runtime/src/vulkan_replay.h b/runtime/src/vulkan_replay.h
index 889bb71f72096ad7b630b9b1805f79502783886f..f83e25b1365ba52f370813081624d467c51362f1 100644
--- a/runtime/src/vulkan_replay.h
+++ b/runtime/src/vulkan_replay.h
@@ -97,6 +97,7 @@ struct ResourceBinding {
     bool sampled = false;              // has SAMPLED usage (no DENY_SHADER_RESOURCE): the present compose pass reads it
     bool host_readable = false;        // D3D12_HEAP_TYPE_READBACK (or CUSTOM write-back): needs host-read flush
     bool sparse_buffer = false;
+    VkDeviceAddress imported_address = 0;  // Vulkan address at va for a title-placed host allocation
 };
 
 struct VulkanAccess {
@@ -803,6 +804,14 @@ enum class ReplayResult {
     unsupported
 };
 
+// Include the last vertex itself when choosing among overlapping buffer ranges.
+inline std::uint64_t ray_vertex_bytes(const RtTriangleGeometry& t) {
+    if (!t.vertex_count) return 0;
+    const auto format = static_cast<VkFormat>(t.vertex_format);
+    const auto bytes = format == VK_FORMAT_R32G32B32_SFLOAT ? 12u : block_format(format, VK_IMAGE_ASPECT_COLOR_BIT).bytes;
+    return std::uint64_t(t.vertex_count - 1) * t.vertex_stride + bytes;
+}
+
 struct ReplayFunctions {
     // Set 0 for the pipelines that declare one (their own `bindless_set` is only the marker): the device's current
     // generation of it, which a flush may have replaced since the pipeline was made. Null: the pipeline's.
@@ -869,6 +878,14 @@ struct ReplayFunctions {
     VkBuffer zero_buffer = VK_NULL_HANDLE;
     VkDeviceSize zero_offset = 0;
     VkDeviceSize zero_size = 0;
+    std::function<VkDeviceAddress(std::uint64_t, std::uint64_t)> imported_address;
+    VkDeviceAddress ray_address(std::uint64_t va, std::uint64_t bytes = 1) const {
+        if (!va) return 0;
+        if (imported_address) {
+            if (const auto address = imported_address(va, bytes)) return address;
+        }
+        return heap_base + va;
+    }
     std::uint64_t heap_base = 0;  // device address of the GPU address arena (push-constant dwords 32-33)
     // Resolves available binary-occlusion queries to 64-bit 0/1 values, outside conditional rendering.
     std::function<void(VkCommandBuffer, VkQueryPool, std::uint32_t first, std::uint32_t count,
@@ -4059,10 +4076,6 @@ inline void emit(const PreparedList& prepared, VkCommandBuffer command_buffer, c
                                     nullptr);
             }
         } else if (const auto* build = std::get_if<BuildAccelerationStructure>(&command)) {
-            // The build's addresses are console VAs into the GPU address arena (heap_base is its device address).
-            // A null VA (no index buffer, no transform) stays null: heap_base + 0 would name the arena's zero page.
-            const VkDeviceSize heap_base = vk.heap_base;
-            const auto addr = [&](std::uint64_t va) -> VkDeviceAddress { return va ? heap_base + va : 0; };
             std::vector<VkAccelerationStructureGeometryKHR> geoms;
             std::vector<VkAccelerationStructureBuildRangeInfoKHR> ranges;
             if (build->is_tlas) {
@@ -4071,7 +4084,7 @@ inline void emit(const PreparedList& prepared, VkCommandBuffer command_buffer, c
                 g.geometry.instances.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR;
                 g.geometry.instances.arrayOfPointers = p.khr_instances ? VK_TRUE : VK_FALSE;
                 g.geometry.instances.data.deviceAddress =
-                    p.khr_instances ? p.khr_instances : addr(build->instances_va);
+                    p.khr_instances ? p.khr_instances : vk.ray_address(build->instances_va, 64ull * build->instance_count);
                 geoms.push_back(g);
                 ranges.push_back({build->instance_count, 0, 0, 0});
             } else {
@@ -4084,14 +4097,14 @@ inline void emit(const PreparedList& prepared, VkCommandBuffer command_buffer, c
                     auto& tr = g.geometry.triangles;
                     tr.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR;
                     tr.vertexFormat = static_cast<VkFormat>(t.vertex_format);
-                    tr.vertexData.deviceAddress = addr(t.vertex_va);
+                    tr.vertexData.deviceAddress = vk.ray_address(t.vertex_va, ray_vertex_bytes(t));
                     tr.vertexStride = t.vertex_stride;
                     tr.maxVertex = t.vertex_count ? (t.vertex_count - 1u) : 0u;
                     tr.indexType = (t.index_type == 1)
                                        ? VK_INDEX_TYPE_UINT16
                                        : ((t.index_type == 2) ? VK_INDEX_TYPE_UINT32 : VK_INDEX_TYPE_NONE_KHR);
-                    tr.indexData.deviceAddress = addr(t.index_va);
-                    tr.transformData.deviceAddress = addr(t.transform_va);
+                    tr.indexData.deviceAddress = vk.ray_address(t.index_va, (t.index_type == 1 ? 2ull : 4ull) * t.index_count);
+                    tr.transformData.deviceAddress = vk.ray_address(t.transform_va, 48);
                     geoms.push_back(g);
                     const std::uint32_t prim_count =
                         (t.index_type != 0 && t.index_count >= 3) ? (t.index_count / 3u) : (t.vertex_count / 3u);
@@ -4109,7 +4122,7 @@ inline void emit(const PreparedList& prepared, VkCommandBuffer command_buffer, c
             info.dstAccelerationStructure = p.accel_dst;
             info.geometryCount = static_cast<std::uint32_t>(geoms.size());
             info.pGeometries = geoms.data();
-            info.scratchData.deviceAddress = addr(build->scratch_va);
+            info.scratchData.deviceAddress = vk.ray_address(build->scratch_va);
             const VkAccelerationStructureBuildRangeInfoKHR* range_ptr = ranges.data();
             vk.build_acceleration_structures(command_buffer, 1, &info, &range_ptr);
         } else if (const auto* dispatch = std::get_if<Dispatch>(&command)) {
diff --git a/runtime/test/vk_khr_instance_addresses_test.cpp b/runtime/test/vk_khr_instance_addresses_test.cpp
index 66d4a680e3ff640ad3d5dbfdeed0ef4e225fdec4..5e94ef327c5c4a96b9929d84582ad039e9c87319 100644
--- a/runtime/test/vk_khr_instance_addresses_test.cpp
+++ b/runtime/test/vk_khr_instance_addresses_test.cpp
@@ -10,6 +10,7 @@ using vk_queue_stub::handle;
 using vk_queue_stub::buffer;
 std::array<std::uint64_t, 2> staged{};
 unsigned builds = 0;
+std::array<VkDeviceAddress, 4> triangle_addresses{};
 constexpr VkDeviceAddress stage_base = 0x220000;
 constexpr VkDeviceAddress arena_base = 0x300000;
 constexpr VkDeviceAddress imported_base = 0x340000;
@@ -40,8 +41,16 @@ VkDeviceAddress VKAPI_CALL device_address(VkDevice, const VkBufferDeviceAddressI
 }
 void VKAPI_CALL build_instances(VkCommandBuffer, std::uint32_t count, const VkAccelerationStructureBuildGeometryInfoKHR* info,
                                 const VkAccelerationStructureBuildRangeInfoKHR* const*) {
-    if (count == 1 && info->geometryCount == 1 && info->pGeometries[0].geometry.instances.arrayOfPointers &&
-        info->pGeometries[0].geometry.instances.data.deviceAddress == stage_base) ++builds;
+    if (count != 1 || info->geometryCount != 1) return;
+    const auto& geometry = info->pGeometries[0];
+    if (geometry.geometryType == VK_GEOMETRY_TYPE_TRIANGLES_KHR) {
+        const auto& t = geometry.geometry.triangles;
+        triangle_addresses = {t.vertexData.deviceAddress, t.indexData.deviceAddress, t.transformData.deviceAddress,
+                              info->scratchData.deviceAddress};
+    } else if (geometry.geometryType == VK_GEOMETRY_TYPE_INSTANCES_KHR && geometry.geometry.instances.arrayOfPointers &&
+               geometry.geometry.instances.data.deviceAddress == stage_base) {
+        ++builds;
+    }
 }
 PFN_vkVoidFunction VKAPI_CALL ray_proc(VkDevice d, const char* name) {
 #define PROC(api, fn) if (std::strcmp(name, #api) == 0) return reinterpret_cast<PFN_vkVoidFunction>(fn)
@@ -112,5 +121,29 @@ int main() {
     list.host = nullptr;
     ctx.add_resource(1, list);
     EXPECT(queue.execute(batch) == ReplayResult::unsupported && builds == 2);
+    // All four BLAS addresses can point into an import, including an interior vertex view.
+    imported.imported_address = imported_base;
+    imported.size = 1024;
+    ctx.add_resource(2, imported);
+    BuildAccelerationStructure blas{};
+    blas.dst_va = build.dst_va;
+    blas.scratch_va = imported.va + 512;
+    RtTriangleGeometry triangles{};
+    triangles.vertex_va = imported.va + 16;
+    triangles.vertex_count = 3;
+    triangles.vertex_stride = 16;
+    triangles.vertex_format = VK_FORMAT_R32G32B32_SFLOAT;
+    triangles.index_type = 1;
+    triangles.index_va = imported.va + 80;
+    triangles.index_count = 3;
+    triangles.transform_va = imported.va + 96;
+    blas.triangles.push_back(triangles);
+    CommandList triangle_list;
+    EXPECT(triangle_list.build_acceleration_structure(blas) && triangle_list.close());
+    const CommandList* triangle_batch[] = {&triangle_list};
+    EXPECT(queue.execute(triangle_batch) == ReplayResult::success);
+    const std::array<VkDeviceAddress, 4> expected_blas{imported_base + 16, imported_base + 80,
+                                                      imported_base + 96, imported_base + 512};
+    EXPECT(triangle_addresses == expected_blas);
     return 0;
 }
