From aed55524702b961bfacacc6421ea24617d532b18 Mon Sep 17 00:00:00 2001
From: tedin7 <tommasoderosa94@gmail.com>
Date: Mon, 23 Nov 2026 18:33:45 +0100
Subject: [PATCH 2/6] fix: a draw that crosses the index view's end reads index
 0 past it, from a staged copy


diff --git a/runtime/src/vulkan_replay.h b/runtime/src/vulkan_replay.h
index a2c2335c16dccec830aa0eae4e5a9ab69b67653b..4a800fb5f6f1a46d99004a94221434f291b326d1 100644
--- a/runtime/src/vulkan_replay.h
+++ b/runtime/src/vulkan_replay.h
@@ -1089,7 +1089,15 @@ struct PreparedDraw {
     VkBuffer index_buffer = VK_NULL_HANDLE;
     VkDeviceSize index_offset = 0;
     VkIndexType index_type = VK_INDEX_TYPE_UINT16;
-    std::uint32_t index_first = 0;  // firstIndex to draw with: the draw's, or 0 on the zero page (see prepare)
+    std::uint32_t index_first = 0;  // firstIndex to draw with: the draw's, or 0 on the zero page or a staged copy
+    // A draw that reads past the index view's end binds a scratch copy of the indices it fetches instead: the
+    // in-view part copied from the buffer, the rest zero. fill_bytes 0: no copy.
+    struct IndexStage {
+        VkBuffer scratch = VK_NULL_HANDLE;
+        VkDeviceSize scratch_offset = 0, fill_bytes = 0;
+        VkBuffer source = VK_NULL_HANDLE;
+        VkDeviceSize source_offset = 0, copy_bytes = 0;
+    } index_stage;
     VkExtent2D area{};
     std::uint32_t layers = 1;  // the fewest layers any bound attachment view has
 
@@ -1107,6 +1115,7 @@ struct PreparedDraw {
         index_offset = 0;
         index_type = VK_INDEX_TYPE_UINT16;
         index_first = 0;
+        index_stage = {};
         area = {};
         layers = 1;
     }
@@ -2224,29 +2233,44 @@ ReplayResult prepare_draw(const Draw& draw, Resolve&& resolve, const ReplayFunct
         else if (draw.index.format == 42) p.index_type = VK_INDEX_TYPE_UINT32;
         else if (draw.index.va) return ReplayResult::unsupported;
         p.index_first = draw.first;
-        // Index fetches outside the view read 0 in D3D12, but vkCmdBindIndexBuffer binds to the end of the buffer
-        // (the layer's device does not enable VK_KHR_maintenance5 for a bind size). So the view's size decides
-        // here: a draw wholly inside binds the buffer, one wholly outside binds the zero page, and one that
-        // straddles the end is refused rather than reading bytes the view does not cover.
+        // Index fetches outside the view read 0 in D3D12, but vkCmdBindIndexBuffer binds to the end of the buffer (the
+        // layer's device does not enable VK_KHR_maintenance5 for a bind size). A draw wholly inside the view binds
+        // the buffer. One that reads past the view's end binds the zero page when every index is outside, else a
+        // scratch copy of the indices it fetches (in-view part copied, the rest zero), so no byte past the view is read.
         const std::uint64_t index_bytes = p.index_type == VK_INDEX_TYPE_UINT32 ? 4 : 2;
         std::uint64_t view_indices = 0;
-        bool resolved = false;
         if (draw.index.va) {
             std::uint64_t size = draw.index.size;
             if (!vk.buffer_at(draw.index.va, size, p.index_buffer, p.index_offset))
                 return ReplayResult::unresolved_resource;
             view_indices = size / index_bytes;  // size is the view's, cut at the buffer's end
-            resolved = true;
         }
         const std::uint64_t last = std::uint64_t(draw.first) + draw.count;  // one past the last index fetched
-        if (resolved && draw.count > 0 && last > view_indices && draw.first < view_indices)
-            return ReplayResult::unsupported;
-        if (!resolved || (draw.count > 0 && draw.first >= view_indices)) {  // every index reads 0
+        if (!draw.index.va) {
             if (!vk.zero_buffer) return ReplayResult::unresolved_resource;
-            if (resolved && std::uint64_t(draw.count) * index_bytes > vk.zero_size) return ReplayResult::unsupported;
             p.index_buffer = vk.zero_buffer;
             p.index_offset = vk.zero_offset;
             p.index_first = 0;
+        } else if (draw.count > 0 && last > view_indices) {
+            const std::uint64_t inside = draw.first < view_indices ? view_indices - draw.first : 0;
+            const std::uint64_t bytes = std::uint64_t(draw.count) * index_bytes;
+            if (inside == 0 && vk.zero_buffer && bytes <= vk.zero_size) {
+                p.index_buffer = vk.zero_buffer;
+                p.index_offset = vk.zero_offset;
+                p.index_first = 0;
+            } else {
+                if (!vk.copy_scratch || !vk.fill_buffer || !vk.copy_buffer) return ReplayResult::unsupported;
+                const std::uint64_t fill = (bytes + 3) & ~std::uint64_t(3);  // vkCmdFillBuffer: multiples of 4
+                VkBuffer scratch = VK_NULL_HANDLE;
+                VkDeviceSize offset = 0;
+                if (!vk.copy_scratch(fill + 4, scratch, offset)) return ReplayResult::unsupported;
+                offset = (offset + 3) & ~VkDeviceSize(3);  // also a multiple of the index size
+                p.index_stage = {scratch, offset, fill, p.index_buffer,
+                                 p.index_offset + VkDeviceSize(draw.first) * index_bytes, inside * index_bytes};
+                p.index_buffer = scratch;
+                p.index_offset = offset;
+                p.index_first = 0;
+            }
         }
     }
     return ReplayResult::success;
@@ -4206,6 +4230,21 @@ inline void emit(const PreparedList& prepared, VkCommandBuffer command_buffer, c
             const GraphicsPipeline& graphics = *d.graphics;
             if (d.depth.id && (graphics.depth_aspects & VK_IMAGE_ASPECT_DEPTH_BIT)) rendering.pDepthAttachment = &depth;
             if (d.depth.id && (graphics.depth_aspects & VK_IMAGE_ASPECT_STENCIL_BIT)) rendering.pStencilAttachment = &depth;
+            if (d.index_stage.fill_bytes) {
+                const auto& stage = d.index_stage;
+                constexpr VkAccessFlags transfer_rw = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+                detail::memory_barrier(vk, command_buffer, VK_ACCESS_MEMORY_WRITE_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                               transfer_rw, VK_PIPELINE_STAGE_TRANSFER_BIT);
+                vk.fill_buffer(command_buffer, stage.scratch, stage.scratch_offset, stage.fill_bytes, 0);
+                if (stage.copy_bytes) {
+                    detail::memory_barrier(vk, command_buffer, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                   transfer_rw, VK_PIPELINE_STAGE_TRANSFER_BIT);
+                    const VkBufferCopy region{stage.source_offset, stage.scratch_offset, stage.copy_bytes};
+                    vk.copy_buffer(command_buffer, stage.source, stage.scratch, 1, &region);
+                }
+                detail::memory_barrier(vk, command_buffer, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                               VK_ACCESS_INDEX_READ_BIT, VK_PIPELINE_STAGE_VERTEX_INPUT_BIT);
+            }
             vk.begin_rendering(command_buffer, &rendering);
 
             ShaderUserData data{};
diff --git a/runtime/test/d3d12_draw_test.cpp b/runtime/test/d3d12_draw_test.cpp
index 0592827f5aec4eeac19fb076a8407a929d62b0b9..87692677180ecc85c8ea84d1baebeeeb5ffb3752 100644
--- a/runtime/test/d3d12_draw_test.cpp
+++ b/runtime/test/d3d12_draw_test.cpp
@@ -567,9 +567,10 @@ int main() {
                 {strip_off_pso.p, {upload_va + 3072, 8, DXGI_FORMAT_R16_UINT}, 4, &view_out_pixels, 4},
                 // Negative control: the view covers the 8 indices, the same draw reads the quad.
                 {strip_off_pso.p, {upload_va + 3072, 16, DXGI_FORMAT_R16_UINT}, 4, &view_in_pixels, 4},
-                // Indices 2..5 cross the view's end: refused, nothing is read outside the view.
-                {strip_off_pso.p, {upload_va + 3072, 8, DXGI_FORMAT_R16_UINT}, 4, &view_straddle_pixels, 2,
-                 leonida::ReplayResult::unsupported},
+                // Indices 2..5 cross the view's end: 2 and 3 are read, 4 and 5 are outside and read 0, so the strip is
+                // (2, 3, 0, 0): one triangle (2, 3, 0) of the top-left quad. Without the cut the buffer's 0, 1 would
+                // give (2, 3, 0, 1), the whole quad.
+                {strip_off_pso.p, {upload_va + 3072, 8, DXGI_FORMAT_R16_UINT}, 4, &view_straddle_pixels, 2},
             };
             UINT64 strip_fence = 10;
             for (const auto& sp : strip_passes) {
@@ -1132,6 +1133,11 @@ int main() {
         }
     }
     EXPECT(view_out_red == 0);
+    // Straddling draw: the strip is (2, 3, 0, 0), the lower-left half of the quad; the buffer's own 0, 1 would also
+    // paint the upper-right half.
+    const auto straddle_px = [&](UINT col, UINT row) { return view_straddle_pixels.data() + row * 256 + col * 4; };
+    EXPECT(straddle_px(4, 28)[0] == 255 && straddle_px(4, 28)[2] == 0);  // lower-left corner of the quad: drawn
+    EXPECT(straddle_px(28, 4)[0] == 0 && straddle_px(28, 4)[2] == 255);   // upper-right corner: blue
     EXPECT(view_in_tl_red == (size / 2) * (size / 2));
     std::printf("index view size: draw past the view painted %u red pixels (want 0); view covering the draw painted "
                 "%u of %u top-left pixels\n", view_out_red, view_in_tl_red, (size / 2) * (size / 2));

From 0ddc28cc06c52a08395b06f2ce089517847de748 Mon Sep 17 00:00:00 2001
From: tedin7 <tommasoderosa94@gmail.com>
Date: Mon, 23 Nov 2026 18:35:20 +0100
Subject: [PATCH 3/6] fix: scratch buffers allow index-buffer use for the
 staged index copy


diff --git a/runtime/src/vulkan_scratch.h b/runtime/src/vulkan_scratch.h
index 4a8a59ddd71b2cd4585f757e0ebddad4fc7ca58d..b656a950743a0a0c84bb1f53939b90f64e66a404 100644
--- a/runtime/src/vulkan_scratch.h
+++ b/runtime/src/vulkan_scratch.h
@@ -148,7 +148,8 @@ private:
     bool make_chunk(std::uint64_t size, Chunk& out) {
         VkBufferCreateInfo info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
         info.size = size;
-        info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+        // INDEX_BUFFER: a draw that reads past its index view's end binds a staged copy (vulkan_replay.h, prepare).
+        info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT;
         if (vk_.vkCreateBuffer(device_, &info, nullptr, &out.buffer) != VK_SUCCESS) return false;
         VkMemoryRequirements requirements{};
         vk_.vkGetBufferMemoryRequirements(device_, out.buffer, &requirements);

